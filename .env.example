# Client-side (Vite inlines VITE_-prefixed vars into the browser bundle -
# only ever put values here that are safe to expose publicly).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only (api/ serverless functions). No VITE_ prefix on purpose -
# these must never be bundled into client code. Set these in Vercel project
# settings, not in a committed .env file.
SUPABASE_SERVICE_ROLE_KEY=
PAYSTACK_SECRET_KEY=
APP_URL=
